# Django
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_DB=yesas_db
POSTGRES_USER=yesas_app
POSTGRES_PASSWORD=replace-with-a-strong-password

DATABASE_URL=postgresql://yesas_app:replace-with-a-strong-password@127.0.0.1:5433/yesas_db

# SMTP settings are required before enabling production email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Use a persistent private volume in production, outside the static-file root.
MEDIA_PRIVATE_ROOT=/path/to/persistent/private-media
MEDIA_IMAGE_MAX_BYTES=12582912
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_DIMENSION=8192
MEDIA_IMAGE_MAX_PIXELS=20000000
MEDIA_THUMBNAIL_MAX_DIMENSION=512
# Optional Nginx internal URI, e.g. /internal-media/
MEDIA_X_ACCEL_PREFIX=
